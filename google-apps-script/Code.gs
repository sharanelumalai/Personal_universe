const SHEET_ID='PASTE_YOUR_GOOGLE_SHEET_ID';
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const data=JSON.parse(e.postData.contents||'{}');const ss=SpreadsheetApp.openById(SHEET_ID);let sh=ss.getSheetByName('Love Feedback');if(!sh)sh=ss.insertSheet('Love Feedback');const qs=(data.answers||[]).map(x=>x.question);if(sh.getLastRow()===0)sh.appendRow(['Submitted At',...qs]);const safe=v=>{v=String(v??'');return /^[=+\-@]/.test(v)?"'"+v:v};sh.appendRow([data.submittedAt||new Date().toISOString(),...(data.answers||[]).map(x=>safe(x.answer))]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON);}finally{lock.releaseLock();}}
